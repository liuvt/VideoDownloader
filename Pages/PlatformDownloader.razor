@page "/youtube-video-downloader"
@page "/facebook-video-downloader"
@page "/tiktok-video-downloader"
@page "/instagram-video-downloader"
@page "/twitter-video-downloader"
@page "/reddit-video-downloader"
@page "/threads-video-downloader"
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<SiteOptions> SiteOptionsAccessor

<PageTitle>@Page.Title</PageTitle>
<section class="platform-page-hero" aria-labelledby="platform-page-title">
    <div class="platform-page-kicker">
        <span class="platform-page-badge @Page.CssClass">@Page.Badge</span>
        <span class="section-label">PLATFORM GUIDE</span>
    </div>
    <h1 id="platform-page-title">@Page.Heading</h1>
    <p>@Page.Intro</p>
    <div class="platform-page-actions">
        <a class="download-button" href="/#download">Paste a @Page.DisplayName link</a>
        <a class="button secondary" href="/">View all platforms</a>
    </div>
</section>

<section class="platform-page-grid" aria-label="@Page.DisplayName download instructions">
    <article class="platform-detail-card">
        <span class="section-label">SUPPORTED LINKS</span>
        <h2>Links Clip2Down can recognize</h2>
        <ul class="platform-link-list">
            @foreach (var link in Page.LinkExamples)
            {
                <li><code>@link</code></li>
            }
        </ul>
    </article>

    <article class="platform-detail-card platform-detail-dark">
        <span class="section-label">OUTPUT</span>
        <h2>MP4 video or MP3 audio</h2>
        <p>Paste the link first. Clip2Down detects the formats reported by the source and shows only the MP4 resolutions that actually exist, plus MP3 when audio is available.</p>
    </article>

    <article class="platform-detail-card">
        <span class="section-label">HOW TO</span>
        <h2>Three quick steps</h2>
        <ol class="platform-steps">
            <li>Open the public @Page.DisplayName post and copy its share URL.</li>
            <li>Paste the URL on the Clip2Down homepage and wait for the available MP4 resolutions and MP3 option to appear.</li>
            <li>Wait for processing, then use the Save file button.</li>
        </ol>
    </article>

    <article class="platform-detail-card">
        <span class="section-label">ACCESS NOTE</span>
        <h2>Public and authorized media only</h2>
        <p>@Page.AccessNote</p>
    </article>
</section>


<section class="platform-search-intent" aria-labelledby="platform-search-intent-title">
    <div class="section-intro">
        <span class="section-label">POPULAR SEARCHES</span>
        <h2 id="platform-search-intent-title">Popular @Page.DisplayName downloader searches</h2>
        <p>These related phrases describe common ways people look for this tool. Each one uses the same public-link workflow above.</p>
    </div>
    <div class="seo-query-chips" aria-label="Related @Page.DisplayName downloader searches">
        @foreach (var phrase in Page.SearchPhrases)
        {
            <a href="/#download">@phrase</a>
        }
    </div>
</section>

<section class="platform-related" aria-labelledby="platform-related-title">
    <div class="section-intro">
        <span class="section-label">RELATED TOOLS</span>
        <h2 id="platform-related-title">More online video downloader guides</h2>
    </div>
    <nav class="seo-query-chips" aria-label="Related video downloader guides">
        @foreach (var related in PlatformSeoPage.All.Values.Where(x => x.Path != Page.Path).Take(6))
        {
            <a href="@related.Path">@related.DisplayName video downloader</a>
        }
    </nav>
</section>

<section class="platform-faq" aria-labelledby="platform-faq-title">
    <div class="section-intro">
        <span class="section-label">FAQ</span>
        <h2 id="platform-faq-title">@Page.DisplayName downloader questions</h2>
    </div>
    <div class="faq-list">
        <details>
            <summary>Does Clip2Down remove watermarks or access controls?</summary>
            <p>No. Clip2Down retrieves media that the server can access and doesn't bypass DRM, paywalls, private-account controls or other platform restrictions.</p>
        </details>
        <details>
            <summary>Why can a valid link still fail?</summary>
            <p>Platforms change frequently. A link may also be private, region-restricted, age-restricted, login-only or temporarily unsupported by the installed yt-dlp version.</p>
        </details>
        <details>
            <summary>Can I download copyrighted media?</summary>
            <p>Only download media you own, have permission to save, or may lawfully use under the applicable license and local rules.</p>
        </details>
    </div>
</section>

@code {
    private PlatformSeoPage Page { get; set; } = PlatformSeoPage.YouTube;

    private string CanonicalUrl
    {
        get
        {
            var baseUrl = SiteOptionsAccessor.Value.BaseUrl?.TrimEnd('/');
            if (string.IsNullOrWhiteSpace(baseUrl))
            {
                baseUrl = new Uri(Navigation.Uri).GetLeftPart(UriPartial.Authority);
            }

            return $"{baseUrl}{Page.Path}";
        }
    }

    protected override void OnParametersSet()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/');
        Page = PlatformSeoPage.All.TryGetValue(path, out var page)
            ? page
            : PlatformSeoPage.YouTube;
    }

