@page "/"
@namespace VideoDownloader.Blazor.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Text.Json
@using System.Collections.Generic
@using Microsoft.Extensions.Options
@using VideoDownloader.Blazor.Options
@inject IOptions<SiteOptions> SiteOptionsAccessor
@{
    Layout = null;

    var site = SiteOptionsAccessor.Value;
    var requestOrigin = $"{Request.Scheme}://{Request.Host}";
    var origin = string.IsNullOrWhiteSpace(site.BaseUrl)
        ? requestOrigin
        : site.BaseUrl.TrimEnd('/');
    var normalizedPath = Request.Path.HasValue && Request.Path.Value != "/"
        ? Request.Path.Value!.TrimEnd('/')
        : "/";
    var canonicalUrl = normalizedPath == "/" ? $"{origin}/" : $"{origin}{normalizedPath}";

    var pageSeo = normalizedPath switch
    {
        "/youtube-video-downloader" => ("Free YouTube Video Downloader Online | Clip2Down", "Free YouTube video downloader for accessible videos and Shorts. Save public media as MP4 in HD or extract MP3 audio online."),
        "/facebook-video-downloader" => ("Free Facebook Video & Reels Downloader | Clip2Down", "Download accessible public Facebook videos and Reels online. Save supported Facebook video links as MP4 or extract MP3 audio."),
        "/tiktok-video-downloader" => ("Free TikTok Video Downloader Online | Clip2Down", "Download accessible public TikTok videos online from standard and share links. Save supported TikTok media as MP4 or MP3."),
        "/instagram-video-downloader" => ("Instagram Reels & Video Downloader Online | Clip2Down", "Download accessible public Instagram Reels and video posts online. Save supported Instagram media as MP4 or extract MP3 audio."),
        "/twitter-video-downloader" => ("X (Twitter) Video Downloader Online | Clip2Down", "Download accessible public X and Twitter videos online from status links. Save supported media as MP4 or MP3."),
        "/reddit-video-downloader" => ("Reddit Video Downloader Online – MP4 & MP3 | Clip2Down", "Download accessible public Reddit videos online from posts, redd.it shares and v.redd.it links as MP4 or MP3."),
        "/threads-video-downloader" => ("Threads Video Downloader Online | Clip2Down", "Download accessible public Threads videos online from threads.com and threads.net post links. Save supported media as MP4 or MP3."),
        _ => ("Free Online Video Downloader – MP4 & MP3 | Clip2Down", "Free online video downloader for YouTube, Facebook, TikTok, Instagram, X, Reddit and Threads. Save accessible public videos as MP4 or MP3.")
    };
    var pageTitle = pageSeo.Item1;
    var pageDescription = pageSeo.Item2;
    var socialImageUrl = $"{origin}/images/og-video-downloader.png";

    var faqItems = new object[]
    {
        new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = "Can I use the same field for every supported platform?",
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = "Yes. The URL field recognizes supported YouTube, Facebook, TikTok, Instagram, X (Twitter), Reddit and Threads domains."
            }
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = "Does it support Shorts, Reels, TikTok, X, Reddit and Threads posts?",
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = "Yes, when the media is publicly accessible and the platform allows the server to retrieve the supplied URL."
            }
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = "How long is a completed file stored?",
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = "Files are kept temporarily based on the server retention setting and are deleted automatically afterward."
            }
        }
    };

    var graphItems = new List<object>
    {
        new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["@id"] = $"{origin}/#organization",
            ["name"] = site.Name,
            ["url"] = $"{origin}/",
            ["logo"] = new Dictionary<string, object?>
            {
                ["@type"] = "ImageObject",
                ["url"] = $"{origin}/images/logo.png",
                ["contentUrl"] = $"{origin}/images/logo.png"
            }
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "WebSite",
            ["@id"] = $"{origin}/#website",
            ["url"] = $"{origin}/",
            ["name"] = site.Name,
            ["description"] = site.Description,
            ["publisher"] = new Dictionary<string, object?> { ["@id"] = $"{origin}/#organization" },
            ["inLanguage"] = site.Language
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "WebApplication",
            ["@id"] = $"{origin}/#application",
            ["name"] = site.Name,
            ["alternateName"] = "Online Video Downloader",
            ["url"] = $"{origin}/",
            ["description"] = site.Description,
            ["applicationCategory"] = "MultimediaApplication",
            ["operatingSystem"] = "Any",
            ["browserRequirements"] = "Requires JavaScript and a modern web browser",
            ["isAccessibleForFree"] = true,
            ["featureList"] = new[]
            {
                "Online video downloader",
                "MP4 video export",
                "MP3 audio extraction",
                "Automatic source format detection before download",
                "YouTube, Facebook, TikTok, Instagram, X, Reddit and Threads URL support"
            },
            ["provider"] = new Dictionary<string, object?> { ["@id"] = $"{origin}/#organization" },
            ["inLanguage"] = site.Language,
            ["areaServed"] = new Dictionary<string, object?>
            {
                ["@type"] = "Country",
                ["name"] = "United States"
            },
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["price"] = "0",
                ["priceCurrency"] = "USD"
            }
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "WebPage",
            ["@id"] = $"{canonicalUrl}#webpage",
            ["url"] = canonicalUrl,
            ["name"] = pageTitle,
            ["description"] = pageDescription,
            ["inLanguage"] = site.Language,
            ["isPartOf"] = new Dictionary<string, object?>
            {
                ["@id"] = $"{origin}/#website"
            }
        }
    };

    if (normalizedPath == "/")
    {
        graphItems.Add(new Dictionary<string, object?>
        {
            ["@type"] = "ItemList",
            ["@id"] = $"{canonicalUrl}#platforms",
            ["name"] = "Online video downloader tools",
            ["itemListElement"] = new object[]
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "YouTube Video Downloader", ["url"] = $"{origin}/youtube-video-downloader" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Facebook Video Downloader", ["url"] = $"{origin}/facebook-video-downloader" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = "TikTok Video Downloader", ["url"] = $"{origin}/tiktok-video-downloader" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 4, ["name"] = "Instagram Reels Downloader", ["url"] = $"{origin}/instagram-video-downloader" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 5, ["name"] = "X Twitter Video Downloader", ["url"] = $"{origin}/twitter-video-downloader" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 6, ["name"] = "Reddit Video Downloader", ["url"] = $"{origin}/reddit-video-downloader" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 7, ["name"] = "Threads Video Downloader", ["url"] = $"{origin}/threads-video-downloader" }
            }
        });

        graphItems.Add(new Dictionary<string, object?>
        {
            ["@type"] = "FAQPage",
            ["@id"] = $"{canonicalUrl}#faq",
            ["mainEntity"] = faqItems
        });
    }
    else
    {
        graphItems.Add(new Dictionary<string, object?>
        {
            ["@type"] = "BreadcrumbList",
            ["@id"] = $"{canonicalUrl}#breadcrumb",
            ["itemListElement"] = new object[]
            {
                new Dictionary<string, object?>
                {
                    ["@type"] = "ListItem",
                    ["position"] = 1,
                    ["name"] = "Clip2Down",
                    ["item"] = $"{origin}/"
                },
                new Dictionary<string, object?>
                {
                    ["@type"] = "ListItem",
                    ["position"] = 2,
                    ["name"] = pageTitle,
                    ["item"] = canonicalUrl
                }
            }
        });
    }

    var structuredData = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = graphItems
    };

    var jsonLd = JsonSerializer.Serialize(structuredData);
}

<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="ServerPrerendered" />

    <meta name="description" content="@pageDescription" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="@site.Name" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content="@site.Name" />
    <meta http-equiv="content-language" content="en-US" />
    <meta name="theme-color" content="#0d1117" />
    <meta name="color-scheme" content="light" />

    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="en-US" href="@canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="@site.Name" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@socialImageUrl" />
    <meta property="og:image:secure_url" content="@socialImageUrl" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Clip2Down online multi-platform video downloader" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@socialImageUrl" />
    <meta name="twitter:image:alt" content="Clip2Down online video downloader" />

    <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    <link rel="stylesheet" href="css/site.css" asp-append-version="true" />


    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4772558027240339"
     crossorigin="anonymous"></script>
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />
    <!-- Reconnect element ẩn hoàn toàn -->
    <div id="components-reconnect-modal"
        class="components-reconnect-hide"
        aria-hidden="true"></div>
    <script src="~/js/blazor-reconnect.js" asp-append-version="true"></script>

    <script src="js/site.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js" autostart="false"></script>

    <script>
    Blazor.start({
        configureSignalR: function (builder) {
            // Cho phép mạng di động chậm hoặc tab vừa được đánh thức
            builder.withServerTimeout(60000);
            builder.withKeepAliveInterval(15000);
        },

        reconnectionOptions: {
            maxRetries: 20,

            retryIntervalMilliseconds: function (previousAttempts) {
                const delays = [
                    0,
                    500,
                    1000,
                    2000,
                    3000,
                    5000,
                    10000,
                    15000,
                    30000
                ];

                return delays[
                    Math.min(previousAttempts, delays.length - 1)
                ];
            }
        }
    });
</script>
</body>
</html>
