@page "/"
@namespace VideoDownloader.Blazor.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Text.Json
@using System.Collections.Generic
@using Microsoft.Extensions.Options
@using VideoDownloader.Blazor.Options
@inject IOptions<SiteOptions> SiteOptionsAccessor
@{
    Layout = null;

    var site = SiteOptionsAccessor.Value;
    var requestOrigin = $"{Request.Scheme}://{Request.Host}";
    var origin = string.IsNullOrWhiteSpace(site.BaseUrl)
        ? requestOrigin
        : site.BaseUrl.TrimEnd('/');
    var normalizedPath = Request.Path.HasValue && Request.Path.Value != "/"
        ? Request.Path.Value!.TrimEnd('/')
        : "/";
    var canonicalUrl = normalizedPath == "/" ? $"{origin}/" : $"{origin}{normalizedPath}";

    var pageSeo = normalizedPath switch
    {
        "/youtube-video-downloader" => ("YouTube Video Downloader – MP4 & MP3 | Clip2Down", "Download accessible YouTube videos and Shorts as MP4 or MP3. Choose HD quality and save public media you are authorized to use."),
        "/facebook-video-downloader" => ("Facebook Video Downloader for Videos & Reels | Clip2Down", "Download accessible public Facebook videos and Reels as MP4 or MP3 with a fast browser-based workflow."),
        "/tiktok-video-downloader" => ("TikTok Video Downloader – Save Public TikTok Videos | Clip2Down", "Download accessible public TikTok videos as MP4 or MP3 from standard and vm.tiktok.com share links."),
        "/instagram-video-downloader" => ("Instagram Video Downloader for Reels & Posts | Clip2Down", "Download accessible public Instagram Reels and video posts as MP4 or MP3 from a supported link."),
        "/twitter-video-downloader" => ("X (Twitter) Video Downloader – MP4 & MP3 | Clip2Down", "Download accessible public videos from X and Twitter status links as MP4 or MP3."),
        _ => ("YouTube, Facebook, TikTok & Instagram Downloader | Clip2Down", site.Description)
    };
    var pageTitle = pageSeo.Item1;
    var pageDescription = pageSeo.Item2;
    var socialImageUrl = $"{origin}/images/og-video-downloader.png";

    var faqItems = new object[]
    {
        new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = "Can I use the same field for every supported platform?",
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = "Yes. The URL field recognizes supported YouTube, Facebook, TikTok, Instagram and X (Twitter) domains."
            }
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = "Does it support Shorts, Reels, TikTok videos and X posts?",
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = "Yes, when the media is publicly accessible and the platform allows the server to retrieve the supplied URL."
            }
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = "How long is a completed file stored?",
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = "Files are kept temporarily based on the server retention setting and are deleted automatically afterward."
            }
        }
    };

    var graphItems = new List<object>
    {
        new Dictionary<string, object?>
        {
            ["@type"] = "WebSite",
            ["@id"] = $"{origin}/#website",
            ["url"] = $"{origin}/",
            ["name"] = site.Name,
            ["description"] = site.Description,
            ["inLanguage"] = site.Language
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "WebApplication",
            ["@id"] = $"{origin}/#application",
            ["name"] = site.Name,
            ["alternateName"] = "Online Video Downloader",
            ["url"] = $"{origin}/",
            ["description"] = site.Description,
            ["applicationCategory"] = "MultimediaApplication",
            ["operatingSystem"] = "Any",
            ["browserRequirements"] = "Requires JavaScript and a modern web browser",
            ["inLanguage"] = site.Language,
            ["areaServed"] = new Dictionary<string, object?>
            {
                ["@type"] = "Country",
                ["name"] = "United States"
            },
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["price"] = "0",
                ["priceCurrency"] = "USD"
            }
        },
        new Dictionary<string, object?>
        {
            ["@type"] = "WebPage",
            ["@id"] = $"{canonicalUrl}#webpage",
            ["url"] = canonicalUrl,
            ["name"] = pageTitle,
            ["description"] = pageDescription,
            ["inLanguage"] = site.Language,
            ["isPartOf"] = new Dictionary<string, object?>
            {
                ["@id"] = $"{origin}/#website"
            }
        }
    };

    if (normalizedPath == "/")
    {
        graphItems.Add(new Dictionary<string, object?>
        {
            ["@type"] = "FAQPage",
            ["@id"] = $"{canonicalUrl}#faq",
            ["mainEntity"] = faqItems
        });
    }

    var structuredData = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = graphItems
    };

    var jsonLd = JsonSerializer.Serialize(structuredData);
}

<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="ServerPrerendered" />

    <meta name="description" content="@pageDescription" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="@site.Name" />
    <meta name="application-name" content="@site.Name" />
    <meta http-equiv="content-language" content="en-US" />
    <meta name="theme-color" content="#0d1117" />
    <meta name="color-scheme" content="light" />

    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="en-US" href="@canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    <link rel="manifest" href="site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="images/favicon.svg" />
    <link rel="apple-touch-icon" href="images/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="@site.Name" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@socialImageUrl" />
    <meta property="og:image:secure_url" content="@socialImageUrl" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Clip2Down online multi-platform video downloader" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@socialImageUrl" />
    <meta name="twitter:image:alt" content="Clip2Down online video downloader" />

    <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    <link rel="stylesheet" href="css/site.css" asp-append-version="true" />


    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4772558027240339"
     crossorigin="anonymous"></script>
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />
    <!-- Reconnect element ẩn hoàn toàn -->
    <div id="components-reconnect-modal"
        class="components-reconnect-hide"
        aria-hidden="true"></div>
    <script src="~/js/blazor-reconnect.js" asp-append-version="true"></script>

    <script src="js/site.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js" autostart="false"></script>

    <script>
    Blazor.start({
        configureSignalR: function (builder) {
            // Cho phép mạng di động chậm hoặc tab vừa được đánh thức
            builder.withServerTimeout(60000);
            builder.withKeepAliveInterval(15000);
        },

        reconnectionOptions: {
            maxRetries: 20,

            retryIntervalMilliseconds: function (previousAttempts) {
                const delays = [
                    0,
                    500,
                    1000,
                    2000,
                    3000,
                    5000,
                    10000,
                    15000,
                    30000
                ];

                return delays[
                    Math.min(previousAttempts, delays.length - 1)
                ];
            }
        }
    });
</script>
</body>
</html>
