@implements IDisposable
@inject DownloadJobStore JobStore
@inject IVideoDownloadQueue Queue
@inject ProviderUrlValidator UrlValidator
@inject IJSRuntime JS
@inject IOptions<DownloaderOptions> DownloaderConfiguration

