<section id="download" class="download-section" aria-labelledby="download-title">
    <div class="download-card">
        <div class="download-card-top">
            <div>
                <span class="section-label">01 / DOWNLOAD</span>
                <h2 id="download-title">Paste a video link</h2>
                <p>Use a supported public YouTube, Facebook, TikTok, Instagram or X URL.</p>
            </div>
            <div class="provider-icons" aria-label="Supported platforms">
                <span class="provider youtube" title="YouTube">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.2a2.8 2.8 0 0 0-2-2C17.9 4.7 12 4.7 12 4.7s-5.9 0-7.6.5a2.8 2.8 0 0 0-2 2A29.8 29.8 0 0 0 2 12a29.8 29.8 0 0 0 .4 4.8 2.8 2.8 0 0 0 2 2c1.7.5 7.6.5 7.6.5s5.9 0 7.6-.5a2.8 2.8 0 0 0 2-2A29.8 29.8 0 0 0 22 12a29.8 29.8 0 0 0-.4-4.8ZM10 15.3V8.7l5.7 3.3L10 15.3Z" /></svg>
                </span>
                <span class="provider facebook" title="Facebook">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.7 22v-9h3l.5-3.5h-3.5V7.2c0-1 .3-1.7 1.8-1.7h1.9V2.4c-.3 0-1.5-.1-2.8-.1-2.8 0-4.7 1.7-4.7 4.8v2.4H6.8V13h3.1v9h3.8Z" /></svg>
                </span>
                <span class="provider provider-text tiktok" title="TikTok">TT</span>
                <span class="provider provider-text instagram" title="Instagram">IG</span>
                <span class="provider provider-text twitter" title="X (Twitter)">X</span>
            </div>
        </div>

        <EditForm Model="Request" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <label class="sr-only" for="video-url">Supported social video URL</label>
            <div class="url-shell">
                <span class="url-prefix" aria-hidden="true">URL</span>
                <InputText id="video-url"
                           class="url-input"
                           @bind-Value="Request.Url"
                           autocomplete="url"
                           inputmode="url"
                           spellcheck="false"
                           placeholder="Paste a YouTube, TikTok, Instagram, Facebook or X link" />
                <button class="paste-button" type="button" @onclick="PasteFromClipboardAsync" aria-label="Paste URL from clipboard">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5h6m-6 0a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-6 0H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2m-6 8h6m-6 4h4" /></svg>
                    Paste
                </button>
            </div>
            <ValidationMessage For="@(() => Request.Url)" />

            <div class="download-options">
                <div class="field-group">
                    <label for="kind">File type</label>
                    <div class="select-wrap">
                        <InputSelect id="kind" class="select-input" @bind-Value="Request.Kind">
                            <option value="@DownloadKind.Video">MP4 video</option>
                            <option value="@DownloadKind.Audio">MP3 audio</option>
                        </InputSelect>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4" /></svg>
                    </div>
                </div>
                <div class="field-group">
                    <label for="quality">Video quality</label>
                    <div class="select-wrap">
                        <InputSelect id="quality"
                                     class="select-input"
                                     @bind-Value="Request.Quality"
                                     disabled="@(Request.Kind == DownloadKind.Audio)">
                            <option value="360">360p · Compact</option>
                            <option value="480">480p · Standard</option>
                            <option value="720">720p · HD</option>
                            <option value="1080">1080p · Full HD</option>
                            <option value="best">Best available</option>
                        </InputSelect>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4" /></svg>
                    </div>
                </div>
                <button class="download-button" type="submit" disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>Starting...</span>
                    }
                    else
                    {
                        <span>Analyze &amp; download</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                    }
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(FormError))
            {
                <div class="alert error" role="alert">@FormError</div>
            }
        </EditForm>

        <div class="privacy-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4.5 5v5.7c0 4.8 3.2 9.2 7.5 10.6 4.3-1.4 7.5-5.8 7.5-10.6V5L12 2Zm-1 13-3-3 1.4-1.4 1.6 1.6 3.6-3.6L16 10l-5 5Z" /></svg>
            Downloaded files are stored temporarily and removed automatically.
        </div>
    </div>
</section>

<section class="trend-board" aria-labelledby="trending-title">
