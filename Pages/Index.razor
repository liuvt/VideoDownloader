@code {
    private readonly CancellationTokenSource _refreshCancellation = new();
    private readonly Guid _sessionId = Guid.NewGuid();
    private int _sessionClosed;
    private DownloadRequest Request { get; } = new();
    private IReadOnlyList<DownloadJob> Jobs { get; set; } = Array.Empty<DownloadJob>();
    private bool IsSubmitting { get; set; }
    private string? FormError { get; set; }
    private Guid? _pendingScrollJobId;
    private Guid? _lastSubmittedJobId;
    private const string RetentionText = "until this tab is closed";

    protected override void OnInitialized()
    {
        RefreshJobs();
        _ = RefreshLoopAsync(_refreshCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "videoDownloader.registerSessionClose",
                    _sessionId.ToString("N"));
            }
            catch (JSException)
            {
                // The browser may disconnect while a Blazor Server circuit is closing.
            }
            catch (InvalidOperationException)
            {
                // JavaScript interop is unavailable during prerendering or shutdown.
            }
        }

        if (_pendingScrollJobId is not Guid jobId)
        {
            return;
        }

        _pendingScrollJobId = null;

        try
        {
            await JS.InvokeVoidAsync(
                "videoDownloader.scrollToDownloadActivity",
                $"download-job-{jobId:N}");
        }
        catch (JSException)
        {
            // The browser may disconnect while a Blazor Server circuit is closing.
        }
        catch (InvalidOperationException)
        {
            // JavaScript interop is unavailable during prerendering or shutdown.
        }
    }

    private async Task PasteFromClipboardAsync()
    {
        FormError = null;

        try
        {
            var clipboardText = await JS.InvokeAsync<string>("videoDownloader.readClipboard");
            if (string.IsNullOrWhiteSpace(clipboardText))
            {
                FormError = "Your clipboard does not contain a video URL.";
                return;
            }

            Request.Url = clipboardText;
        }
        catch
        {
            FormError = "Clipboard access was blocked. Press Ctrl + V or Command + V to paste the link.";
        }
    }

    private async Task SubmitAsync()
    {
        FormError = null;
        IsSubmitting = true;

        try
        {
            if (!UrlValidator.TryValidate(Request.Url, out var uri, out var error))
            {
                FormError = error;
                return;
            }

            var quality = Request.Kind == DownloadKind.Audio ? "audio" : Request.Quality;
            var job = JobStore.Create(
                _sessionId,
                uri!.AbsoluteUri,
                Request.Kind,
                quality);

            try
            {
                await Queue.QueueAsync(job.Id);
            }
            catch
            {
                JobStore.Remove(job.Id);
                throw;
            }

            Request.Url = string.Empty;
            _lastSubmittedJobId = job.Id;
            _pendingScrollJobId = job.Id;
            RefreshJobs();
        }
        catch (Exception ex)
        {
            FormError = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    RefreshJobs();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void RefreshJobs() => Jobs = JobStore.GetLatest(_sessionId);

    private static string StatusText(DownloadJobStatus status) => status switch
    {
        DownloadJobStatus.Queued => "Queued",
        DownloadJobStatus.ReadingMetadata => "Reading details",
        DownloadJobStatus.Downloading => "Downloading",
        DownloadJobStatus.Processing => "Processing",
        DownloadJobStatus.Completed => "Ready",
        DownloadJobStatus.Failed => "Failed",
        DownloadJobStatus.Cancelled => "Cancelled",
        _ => status.ToString()
    };

    private static string StatusClass(DownloadJobStatus status) => status switch
    {
        DownloadJobStatus.Completed => "success",
        DownloadJobStatus.Failed => "danger",
        DownloadJobStatus.Cancelled => "muted",
        DownloadJobStatus.Downloading or DownloadJobStatus.Processing => "active",
        _ => "muted"
    };

    private static string FormatJobMeta(DownloadJob job)
    {
        var format = job.Kind == DownloadKind.Audio
            ? "MP3"
            : job.Quality == "best" ? "MP4 · Best available" : $"MP4 · {job.Quality}p";

        var fallback = job.UsedDirectFallback ? " · Direct fallback" : string.Empty;

        if (job.DurationSeconds is null)
        {
            return format + fallback;
        }

        var duration = TimeSpan.FromSeconds(job.DurationSeconds.Value);
        var text = duration.TotalHours >= 1
            ? duration.ToString(@"h\:mm\:ss")
            : duration.ToString(@"m\:ss");
        return $"{format} · {text}{fallback}";
    }

    private static string ProgressDetails(DownloadJob job)
    {
        var values = new[] { job.Speed, string.IsNullOrWhiteSpace(job.Eta) ? null : $"ETA {job.Eta}" }
            .Where(x => !string.IsNullOrWhiteSpace(x));
        var result = string.Join(" · ", values!);
        if (!string.IsNullOrWhiteSpace(result))
        {
            return result;
        }

        if (job.Status == DownloadJobStatus.Processing)
        {
            return job.UsedDirectFallback
                ? "Finalizing the direct fallback file"
                : "Merging and converting your file";
        }

        return job.UsedDirectFallback
            ? "Retrying with direct high-quality mode"
            : "Downloading media data";
    }

    public void Dispose()
    {
        if (Interlocked.Exchange(ref _sessionClosed, 1) == 0 &&
            DownloaderConfiguration.Value.DeleteOnSessionClose)
        {
            var grace = TimeSpan.FromSeconds(Math.Clamp(
                DownloaderConfiguration.Value.SessionCloseGraceSeconds,
                0,
                600));

            JobStore.CloseSession(_sessionId, grace);
        }

        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
    }
}
