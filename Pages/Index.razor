@if (Jobs.Count > 0)
{
    <section id="download-activity" class="jobs-section" aria-labelledby="jobs-title" aria-live="polite">
        <div class="section-heading">
            <div>
                <span class="section-label">ACTIVE SESSION</span>
                <h2 id="jobs-title">Download activity</h2>
            </div>
            <span class="job-count">@Jobs.Count recent request@(Jobs.Count == 1 ? string.Empty : "s")</span>
        </div>

        <div class="job-list">
            @foreach (var job in Jobs)
            {
                <article id="@($"download-job-{job.Id:N}")"
                         class="job-card @(job.Id == _lastSubmittedJobId ? "job-card-current" : null)"
                         tabindex="-1">
                    <div class="thumbnail-wrap">
                        @if (!string.IsNullOrWhiteSpace(job.ThumbnailUrl))
                        {
                            <img src="@job.ThumbnailUrl" alt="Video thumbnail" loading="lazy" />
                        }
                        else
                        {
                            <div class="thumbnail-placeholder" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5V7Z" /></svg>
                            </div>
                        }
                    </div>

                    <div class="job-body">
                        <div class="job-topline">
                            <div>
                                <h3>@(job.Title ?? "Reading video details...")</h3>
                                <p>@FormatJobMeta(job)</p>
                            </div>
                            <span class="status @StatusClass(job.Status)">@StatusText(job.Status)</span>
                        </div>

                        @if (job.Status is DownloadJobStatus.Downloading or DownloadJobStatus.Processing)
                        {
                            <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)Math.Round(job.Progress))">
                                <div class="progress-value" style="@($"width: {Math.Clamp(job.Progress, 0, 100):0.##}%")"></div>
                            </div>
                            <div class="progress-meta">
                                <strong>@job.Progress.ToString("0.0")%</strong>
                                <span>@ProgressDetails(job)</span>
                            </div>
                        }

                        @if (job.Status == DownloadJobStatus.Failed)
                        {
                            <div class="alert error compact">@job.ErrorMessage</div>
                        }

                        @if (job.Status == DownloadJobStatus.Completed)
                        {
                            <div class="completed-row">
                                <span>Your file is ready and available for @RetentionText.</span>
                                <a class="button primary small"
                                   href="@($"/downloads/{job.Id}")"
                                   download="@job.FileName">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14" /></svg>
                                    Save file
                                </a>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

